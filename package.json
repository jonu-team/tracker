{
  "name": "team-tracker",
  "private": true,
  "version": "1.0.0",
  "description": "Трекер задач на GitHub Issues: доска, список, страница задачи",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "vite",
    "demo": "vite --mode demo",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "demo:fixture": "node scripts/demo-fixture.ts",
    "migrate": "node scripts/migrate.ts"
  },
  "dependencies": {
    "@preact/signals": "2.11.4",
    "dompurify": "3.4.17",
    "marked": "18.1.3",
    "preact": "11.1.1"
  },
  "devDependencies": {
    "@preact/preset-vite": "2.10.6",
    "@types/node": "26.6.6",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vitest": "5.1.0"
  }
}
